---
import Layout from "@/layouts/Layout.astro";
import RespondInvite from "@/components/debate/RespondInvite";
import { createClient } from "@/lib/supabase";
import { listInvites } from "@/lib/exchange/repository";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

const invites = supabase && user ? await listInvites(supabase, user.id) : [];
---

<Layout title="Invites — WVMap">
  <div class="bg-background min-h-screen p-6">
    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-foreground text-2xl font-bold">Invites</h1>
        <a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors">← Home</a>
      </div>

      {
        invites.length === 0 ? (
          <div class="border-border bg-card rounded-xl border p-8 text-center">
            <p class="text-muted-foreground text-sm">No invites yet.</p>
          </div>
        ) : (
          <ul class="space-y-4">
            {invites.map((invite) => (
              <li class="border-border bg-card rounded-xl border p-5">
                <div class="mb-3 flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <p class="text-foreground truncate font-semibold">{invite.debate_title}</p>
                    {invite.debate_root_claim_title && (
                      <p class="text-muted-foreground mt-0.5 text-sm">Root claim: {invite.debate_root_claim_title}</p>
                    )}
                    {invite.debate_root_claim_body && (
                      <p class="text-muted-foreground mt-0.5 line-clamp-2 text-xs">{invite.debate_root_claim_body}</p>
                    )}
                  </div>
                  <span
                    class:list={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ${
                      invite.status === "pending"
                        ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400"
                        : "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400"
                    }`}
                  >
                    {invite.status === "pending" ? "Pending" : "Accepted"}
                  </span>
                </div>

                <p class="text-muted-foreground mb-3 text-xs">
                  {invite.round_count} round{invite.round_count !== 1 ? "s" : ""} ·{" "}
                  {new Date(invite.created_at).toLocaleDateString()}
                </p>

                <div class="flex flex-wrap items-center gap-3">
                  {/* Challenger can read the map while invite is pending — link shown before accept */}
                  <a
                    href={`/debates/${invite.debate_id}`}
                    class="text-primary text-sm font-medium underline-offset-4 hover:underline"
                  >
                    {invite.status === "pending" ? "View debate" : "Enter debate"}
                  </a>

                  {invite.status === "pending" && <RespondInvite client:load exchangeId={invite.id} />}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
