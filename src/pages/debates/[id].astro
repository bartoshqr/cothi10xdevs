---
import Layout from "@/layouts/Layout.astro";
import MapEditor from "@/components/debate/MapEditor";
import DebateHeader from "@/components/debate/DebateHeader.astro";
import InviteChallenger from "@/components/debate/InviteChallenger";
import TurnBar from "@/components/debate/TurnBar";
import DivergenceSummary from "@/components/debate/DivergenceSummary";
import { createClient } from "@/lib/supabase";
import { getDebateGraph } from "@/lib/debate/repository";
import { getDebateExchange } from "@/lib/exchange/repository";
import { deriveViewer } from "@/lib/debate/viewer";
import { getDebateMarks } from "@/lib/mark/repository";
import type { MarkState } from "@/components/debate/mapVisualLanguage";

const { id: debateId } = Astro.params;
const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS scopes the read to participants (owner or pending/accepted challenger).
const graph = supabase && debateId ? await getDebateGraph(supabase, debateId) : null;

let username: string | null = null;
if (graph && supabase && user) {
  const { data } = await supabase.from("profiles").select("username").eq("id", user.id).single();
  username = data?.username ?? null;
}

const isOwner = graph && user ? graph.debate.owner_id === user.id : false;

// The debate's single open exchange (pending or accepted), with both usernames
// resolved. Drives the advocate's invite line, the challenger's header, and the
// viewer context below.
const exchange = graph && supabase && debateId ? await getDebateExchange(supabase, debateId) : null;

// Who is looking, and is it their turn? (viewer/exchangeId are non-null only once accepted.)
const { viewer, viewerExchangeId } = deriveViewer({ user, graph, isOwner, exchange });

// Pre-load every mark in the debate so the board hydrates correctly for either viewer:
// the challenger sees their own marks (interactive), the advocate sees the challenger's
// marks read-only on their statements once the turn flips. Round 1 has a single marker, so
// one node→{stance,valid} map suffices.
let initialMarks: Partial<Record<string, MarkState>> = {};
if (viewer && supabase && debateId) {
  initialMarks = await getDebateMarks({ supabase, debateId });
}

// Editing is allowed for the advocate before any exchange is opened, OR when it's the advocate's turn.
// A challenger (non-owner participant) had always been read-only (S-02); now they can add their own nodes.
// canEdit (the old pre-exchange flag): true only for the advocate before any exchange exists.
const canEdit = isOwner && exchange === null;

if (!graph) {
  Astro.response.status = 404;
}
---

{
  graph ? (
    <Layout title={`${graph.debate.title} — WVMap`}>
      <div class="flex h-screen flex-col">
        <DebateHeader user={user} username={username} title={graph.debate.title}>
          <div slot="header-actions" class="flex items-center gap-3">
            <DivergenceSummary
              client:only="react"
              debateId={graph.debate.id}
              ownerId={graph.debate.owner_id}
              viewerId={user?.id}
              isCompleted={exchange?.status === "completed"}
              currentRound={exchange?.currentRound ?? 1}
            />
            {isOwner && <InviteChallenger client:load debateId={graph.debate.id} existingExchange={exchange} />}
            {!isOwner &&
              exchange?.advocateUsername &&
              (exchange.status === "accepted" || exchange.status === "completed" ? (
                <TurnBar
                  client:only="react"
                  viewerRole="challenger"
                  isMyTurn={viewer?.isMyTurn ?? exchange.currentTurn === "challenger"}
                  currentRound={exchange.currentRound}
                  roundCount={exchange.roundCount}
                  counterpartUsername={exchange.advocateUsername}
                  isCompleted={exchange.status === "completed"}
                  isMiniTurn={exchange.inMiniTurn}
                />
              ) : (
                <span class="text-muted-foreground text-sm">
                  Advocate @{exchange.advocateUsername} —{" "}
                  <a href="/debates" class="text-primary underline-offset-4 hover:underline">
                    respond on your debates
                  </a>
                </span>
              ))}
          </div>
        </DebateHeader>
        <div class="min-h-0 flex-1">
          <MapEditor
            client:only="react"
            debateId={graph.debate.id}
            initialGraph={graph}
            canEdit={canEdit}
            viewer={viewer}
            exchangeId={viewerExchangeId}
            initialMarks={initialMarks}
            userId={user?.id ?? null}
          />
        </div>
      </div>
    </Layout>
  ) : (
    <Layout title="Debate not found — WVMap">
      <div class="bg-background flex min-h-screen items-center justify-center p-4">
        <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
          <h1 class="text-foreground mb-2 text-xl font-bold">Debate not found</h1>
          <p class="text-muted-foreground mb-6 text-sm">This debate doesn't exist, or you don't have access to it.</p>
          <a href="/" class="text-primary text-sm underline-offset-4 hover:underline">
            Back to home
          </a>
        </div>
      </div>
    </Layout>
  )
}
