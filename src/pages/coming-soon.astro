---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Wkrótce — WVMap">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl">🔜</div>
      <h1 class="text-foreground mb-3 text-2xl font-bold">Wkrótce</h1>
      <p class="text-muted-foreground mb-6">Ta strona jest w przygotowaniu. Wróć za jakiś czas.</p>
      <a href="/" class="text-primary text-sm underline-offset-4 hover:underline">Wróć na stronę główną</a>
    </div>
  </div>
</Layout>
