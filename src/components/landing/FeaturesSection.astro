<section class="border-border border-t py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-foreground text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Funkcje dla poważnego Adwokata
      </h2>
      <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg text-pretty">
        Narzędzia stworzone z myślą o osobach, które traktują debatę poważnie.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:mt-16 md:grid-cols-3">
      <!-- Feature 1: Integralność danych -->
      <div
        class="group border-border bg-card hover:border-primary/30 hover:bg-primary/5 rounded-xl border p-6 transition-colors"
      >
        <div
          class="bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary mb-4 flex h-12 w-12 items-center justify-center rounded-lg transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Integralność danych</h3>
        <p class="text-muted-foreground leading-relaxed">
          Twoja własność intelektualna jest bezpieczna. Żadna ze stron nie może edytować ani usuwać oświadczeń
          przeciwnika.
        </p>
      </div>

      <!-- Feature 2: Wymuszona reewaluacja -->
      <div
        class="group border-border bg-card hover:border-primary/30 hover:bg-primary/5 rounded-xl border p-6 transition-colors"
      >
        <div
          class="bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary mb-4 flex h-12 w-12 items-center justify-center rounded-lg transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path
              d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Wymuszona reewaluacja</h3>
        <p class="text-muted-foreground leading-relaxed">
          Jeśli edytujesz swoje oświadczenie, wcześniejszy sprzeciw oponenta zostaje wyczyszczony — musi on ponownie
          odnieść się do Twoich słów.
        </p>
      </div>

      <!-- Feature 3: Blokada turowa -->
      <div
        class="group border-border bg-card hover:border-primary/30 hover:bg-primary/5 rounded-xl border p-6 transition-colors"
      >
        <div
          class="bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary mb-4 flex h-12 w-12 items-center justify-center rounded-lg transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Blokada turowa</h3>
        <p class="text-muted-foreground leading-relaxed">
          Brak spamu. Ścisłe limity rund (od 1 do 5) sprawiają, że rozmowa jest w pełni intencjonalna.
        </p>
      </div>
    </div>
  </div>
</section>
