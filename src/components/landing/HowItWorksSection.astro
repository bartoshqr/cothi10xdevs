<section id="how-it-works" class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-foreground text-3xl font-bold tracking-tight text-balance sm:text-4xl">How It Works</h2>
      <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg text-pretty">
        Four simple steps to a substantive debate, free of chaos and manipulation.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Step 01 -->
      <div class="border-border bg-card relative rounded-xl border p-6">
        <div class="mb-4 flex items-center justify-between">
          <div class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <line x1="18" y1="2" x2="22" y2="6"></line><path d="M7.5 20.5 19 9l-4-4L3.5 16.5 2 22z"></path>
            </svg>
          </div>
          <span class="text-muted-foreground/30 text-2xl font-bold">01</span>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Build the Case</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Draft your argument using structured Statements (Claims, Data, Warrants) and attach your sources.
        </p>
        <div class="bg-border absolute top-1/2 -right-3 hidden h-px w-6 lg:block"></div>
      </div>

      <!-- Step 02 -->
      <div class="border-border bg-card relative rounded-xl border p-6">
        <div class="mb-4 flex items-center justify-between">
          <div class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line
                x1="19"
                y1="8"
                x2="19"
                y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
          </div>
          <span class="text-muted-foreground/30 text-2xl font-bold">02</span>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Invite a Challenger</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Send a private invite to an opponent. The debate is 1:1, focused, and free from the pressure of an audience.
        </p>
        <div class="bg-border absolute top-1/2 -right-3 hidden h-px w-6 lg:block"></div>
      </div>

      <!-- Step 03 -->
      <div class="border-border bg-card relative rounded-xl border p-6">
        <div class="mb-4 flex items-center justify-between">
          <div class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path
                d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21H17"></path><path d="M12 1v20"
              ></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
            </svg>
          </div>
          <span class="text-muted-foreground/30 text-2xl font-bold">03</span>
        </div>
        <h3 class="text-foreground mb-2 text-lg font-semibold">The Audit</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Turn-based exchanges. They must explicitly "Agree", "Challenge", or "Abstain" on your points before adding
          their own.
        </p>
        <div class="bg-border absolute top-1/2 -right-3 hidden h-px w-6 lg:block"></div>
      </div>

      <!-- Step 04 -->
      <div class="border-border bg-card relative rounded-xl border p-6">
        <div class="mb-4 flex items-center justify-between">
          <div class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg">
            <svg
